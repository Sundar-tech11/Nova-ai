# =========================================================================
#                    NextStep AI - Production Environment Variables Template
# =========================================================================
# This template defines all the environment variables needed to configure and 
# deploy the NextStep AI career growth companion application.
#
# Copy this file to '.env' (for local Express server and development) or 
# configure them in your production platform dashboard (Railway, Vercel, etc.).
#
# DO NOT commit actual secrets, private keys, or API tokens to public repositories!
# =========================================================================

# -------------------------------------------------------------------------
# 1. APPLICATION & SERVER PORT CONFIGURATION
# -------------------------------------------------------------------------
# Define the runtime environment mode ('production', 'development', 'staging')
# Defaults to 'production' on remote environments.
NODE_ENV=production

# The port on which the Express.js server will listen for requests.
# Note: Railway, Cloud Run, and other hosting platforms inject this dynamically.
# For local server running, defaults to 3000.
PORT=3000

# -------------------------------------------------------------------------
# 2. AI ENGINE CONFIGURATION (GOOGLE AI STUDIO - GEMINI API)
# -------------------------------------------------------------------------
# This key is required for all AI features including Nova Career Coach, Resume 
# Analyzer, Portfolio Builder, Skill Tracker, and Interview Practice Simulator.
#
# To get your free API key, visit Google AI Studio:
# https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyD_your_google_gemini_api_key_goes_here

# -------------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIGURATION
# -------------------------------------------------------------------------
# NextStep AI stores user resumes, practice interview transcripts, career paths, 
# and portfolio configs in Firebase Firestore, and manages accounts with Auth.
#
# Under standard development, the application expects a 'firebase-applet-config.json'
# file containing these credentials at the project root:
#
# {
#   "apiKey": "your-api-key",
#   "authDomain": "your-auth-domain",
#   "projectId": "your-project-id",
#   "storageBucket": "your-storage-bucket",
#   "messagingSenderId": "your-messaging-sender-id",
#   "appId": "your-app-id",
#   "firestoreDatabaseId": "(default)"
# }
#
# Ensure this file is present at build time to prevent compilation errors.
# =========================================================================
